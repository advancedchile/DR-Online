# Firebase Connection Configuration for Dragon Raja Game Database
# Supports Firebase Realtime Database (recommended for real-time MMO state) and/or Cloud Firestore.

# Option A: Firebase Realtime Database URL (e.g. https://your-project-id-default-rtdb.firebaseio.com)
FIREBASE_DATABASE_URL=
# Optional Database Secret or Auth Token (leave empty if rules allow authenticated/server access or dev mode)
FIREBASE_DATABASE_SECRET=

# Option B: Cloud Firestore Project ID & Web API Key
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
